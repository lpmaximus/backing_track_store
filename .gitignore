# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Arquivos locais e segredos
arquive/
scripts/

# scripts descartáveis de migração/debug (rodados localmente)
_*.mjs

# BTC/Cog: o clone do repo (com pesos ~24MB) e áudios de teste não vão pro git.
# O modelo já está publicado no Replicate; cog.yaml/predict.py/README bastam.
meu_teste/
replicate/btc-chords/BTC-ISMIR19/
replicate/btc-chords/*.mp3
replicate/btc-chords/.cog/
**/__pycache__/

# chaves de service account (Google Cloud) — nunca commitar
backing-track-*.json
*-serviceaccount*.json
_COLAR_NA_VERCEL.txt
